root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_keep_indents_on_empty_lines = false

[*.{xml,gradle,pro}]

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
